# Copy to .env for local development. Never commit real credentials.
POSTGRES_DB=tomos_pos
POSTGRES_USER=tomos_pos
POSTGRES_PASSWORD=change-this-local-development-password
POSTGRES_PORT=5432

DATABASE_URL=postgres://tomos_pos:change-this-local-development-password@localhost:5432/tomos_pos
API_HOST=127.0.0.1
API_PORT=8080
# Set false only for local HTTP development. Keep true behind HTTPS in production.
COOKIE_SECURE=false
RUST_LOG=info,tomos_pos_api=debug

# Configure only when the relevant integration is implemented.
# APP_BASE_URL=http://localhost:3000
# SESSION_SECRET=replace-with-a-long-random-secret
# HMRC_CLIENT_ID=
# HMRC_CLIENT_SECRET=

# Exact browser origin allowed to call cookie-authenticated state-changing endpoints.
APP_ORIGIN=http://localhost:3000

# SumUp Solo Cloud API (server-side secrets only; sandbox credentials recommended)
# Set all four credentials and the public HTTPS callback origin before testing.
# SUMUP_API_KEY=
# SUMUP_AFFILIATE_KEY=
# SUMUP_MERCHANT_CODE=
# SUMUP_READER_ID=
# SUMUP_PUBLIC_BASE_URL=https://pos.example.com
